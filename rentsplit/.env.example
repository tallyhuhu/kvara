# Frontend public configuration (Vercel)
VITE_API_URL=http://localhost:3001
VITE_RELAYER_URL=https://relayer.1shotapi.com/relayers
VITE_RELAYER_FEE_BUFFER_USDC=0.05
VITE_BASE_BUILDER_CODE=

# Backend runtime (Railway)
PORT=3001
NODE_ENV=development
DATABASE_URL=
DATABASE_SSL=true
BASE_RPC_URL=https://mainnet.base.org

# Attributed autonomous execution (recommended for new permissions)
PAYMENT_EXECUTION_MODE=aa
AGENT_PRIVATE_KEY=
BUNDLER_RPC_URL=https://api.developer.coinbase.com/rpc/v1/base/YOUR_CDP_RPC_TOKEN
AA_PAYMASTER_ENABLED=false

# Browser origin and signed wallet sessions
CORS_ORIGINS=http://localhost:3000
AUTH_DOMAIN=localhost
AUTH_URI=http://localhost:3000
AUTH_SESSION_SECRET=replace-with-at-least-32-random-characters
AUTH_SESSION_TTL_SECONDS=3600
AUTH_CHALLENGE_TTL_SECONDS=300

# Durable scheduler
# Keep false for the first production boot; enable after reviewing existing due households.
SCHEDULER_ENABLED=false
SCHEDULER_POLL_MS=30000
SCHEDULER_LEASE_MS=120000

# 1Shot Permissionless Relayer (legacy permission fallback)
RELAYER_URL=https://relayer.1shotapi.com/relayers
RELAYER_FEE_BUFFER_USDC=0.05
RELAYER_DELEGATION_SECRET=

# Venice AI
VENICE_API_KEY=
VENICE_MODEL=llama-3.3-70b
VENICE_BASE_URL=https://api.venice.ai/api/v1

# Base Builder Code / ERC-8021
BASE_BUILDER_CODE=
